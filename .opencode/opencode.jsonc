{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  "agent": {
    "format-lead": {
      "prompt": "hitl/agents/format-lead.md",
      "description": "Picks the right structural blueprint for a video topic and maps content to the beat-by-beat skeleton. Phase 1 of the video production pipeline.",
    },
    "hook-writer": {
      "prompt": "hitl/agents/hook-writer.md",
      "description": "Writes the first 5-15 seconds of a Human in the Loop YouTube video — the hook. Phase 4 of the video production pipeline.",
    },
    "outliner": {
      "system_prompt_only": true,
      "prompt": "hitl/agents/outliner.md",
      "description": "Builds the bulleted skeleton of a video — validation and sequencing, not writing. Contains the pipeline's hardest gate: the uniqueness gut-check. Phase 3 of the video production pipeline.",
    },
    "setup-writer": {
      "prompt": "hitl/agents/setup-writer.md",
      "description": "Writes the 10-30 seconds immediately after the hook — the click confirm section — that confirms what viewers clicked, names the framework, states the plan, drops credibility, and promises the outcome. Phase 5 of the video production pipeline.",
    },
  },
}
